<%= form_with(model: answer, class: "contents") do |form| %>
  <% if answer.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(answer.errors.count, "error") %> prohibited this answer from being saved:</h2>

      <ul class="list-disc ml-6">
        <% answer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :response %>
    <%= form.textarea :response, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": answer.errors[:response].none?, "border-red-400 focus:outline-red-600": answer.errors[:response].any?}] %>
  </div>

  <%= form_with(model: answer) do |f| %>
    <%= f.hidden_field :question_id %>

    <%= f.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white inline-block font-medium cursor-pointer"%>
<% end %>

<% end %>
